# Flask Application Environment Variables
FLASK_ENV=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production
PORT=5050

# Primary Database (MySQL 8 via PyMySQL)
DB_USER=lifeflow_user
DB_PASSWORD=lifeflow_pass
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lifeflow
DATABASE_URL=mysql+pymysql://lifeflow_user:lifeflow_pass@localhost:3306/lifeflow

# Development Fallback: if MySQL is offline, automatically use SQLite to ensure zero-downtime local dev
ALLOW_SQLITE_FALLBACK=True
SQLITE_DB_PATH=lifeflow.db

# Testing Database (dedicated test_lifeflow schema in MySQL 8)
TEST_DATABASE_URL=mysql+pymysql://lifeflow_user:lifeflow_pass@localhost:3306/test_lifeflow
